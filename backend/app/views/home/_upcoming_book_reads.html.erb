<%= turbo_frame_tag "upcoming_book_reads" do %>
  <div class="flex flex-col w-full">
    <div class="flex items-baseline justify-between mb-4">
      <div class="title title-sm font-bold text-content">
        <%= t("upcoming_reads") %>
      </div>
    </div>

    <div class="flex flex-col gap-3">
      <% @upcoming_book_reads.each do |book_read| %>
        <%= link_to book_club_book_read_path(book_read.book_club, book_read), data: { turbo_frame: "_top" }, class: "block group" do %>
          <%= render "shared/book_read_card",
              book: book_read.book,
              club: book_read.book_club,
              book_read: book_read %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

