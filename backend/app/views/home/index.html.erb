<% content_for :title, t("titles.home") %>
<div class="max-w-4xl mx-auto space-y-12">
  <%= turbo_frame_tag "discover_book_clubs", src: discover_book_clubs_path, loading: :lazy do %>
    <%= render "home/discover_book_clubs_skeleton" %>
  <% end %>
</div>

<div class="max-w-4xl mx-auto space-y-12">
  <%= turbo_frame_tag  "upcoming_book_reads", src: upcoming_book_reads_path, loading: :lazy do %>
    <div class="flex flex-col">
      <div class="flex items-baseline justify-between mb-4">
        <div class="title title-sm font-bold text-content">
          <%= t("upcoming_reads") %>
        </div>
      </div>

      <%= render "home/upcoming_book_reads_skeleton" %>
    </div>
  <% end %>
</div>
