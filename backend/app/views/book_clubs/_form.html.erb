<%= form_with(model: @club, local: true, class: "space-y-6") do |form| %>
  <% if @club.errors.any? %>
    <%= render "devise/shared/error_messages", resource: @club %>
  <% end %>

  <%= render "components/input",
  form: form,
  name: :name,
  label: "Club Name",
  placeholder: "e.g., Sci-Fi Enthusiasts",
  required: true,
  error: @club.errors[:name] %>

  <%= render "components/textarea",
  form: form,
  name: :description,
  label: "Description",
  placeholder: "What is this club about?",
  rows: 4,
  error: @club.errors[:description] %>

  <%= render "components/file_input",
  form: form,
  name: :photo,
  label: "Club Avatar Photo",
  accept: "image/*",
  hint: "Square avatar image for the club profile",
  error: @club.errors[:photo] %>

  <%= render "components/file_input",
  form: form,
  name: :cover_photo,
  label: "Cover Banner Photo",
  accept: "image/*",
  hint: "Wide banner image for the club header",
  error: @club.errors[:cover_photo] %>

  <div class="space-y-6" data-controller="conditional-fields">
    <%= render "components/toggle",
    form: form,
    name: :is_private,
    label: "Make this club private",
    data: {
      action: "change->conditional-fields#toggle",
      conditional_fields_target: "toggle"
    } %>

    <div data-conditional-fields-target="field" class="<%= "hidden" unless @club.is_private %>">
      <%= render "components/input",
      form: form,
      field_type: :url,
      name: :application_form_url,
      label: "Application Form URL",
      placeholder: "https://docs.google.com/forms/...",
      hint: "Shown to people who apply to join your private club (e.g., a Google Form)",
      disabled: !@club.is_private,
      error: @club.errors[:application_form_url] %>
    </div>
  </div>

  <div
    class="
      flex flex-col-reverse sm:flex-row items-center justify-end gap-3 pt-6 border-t
      border-border/60
    ">
    <%= render "components/button",
    label: "Cancel",
    type: "link",
    url: book_clubs_path,
    variant: "ghost",
    classes: "w-full sm:w-auto text-content-subtle hover:text-content" %>
    <%= render "components/button",
    label: (@club.persisted? ? "Update Club" : "Create Club"),
    type: "submit",
    variant: "primary",
    classes: "w-full sm:w-auto" %>
  </div>
<% end %>
