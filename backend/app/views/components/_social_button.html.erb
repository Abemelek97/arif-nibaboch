<%#
  Social Login Button Component (LINE & Telegram)
  Locals:
    - provider: Symbol/String (:line, :telegram)
    - url: String (destination URL for LINE)
    - telegram_bot: String (ENV['TELEGRAM_BOT_NAME'])
    - telegram_auth_url: String (telegram_login_callback_url)
    - classes: String
%>

<%
  provider ||= :line
  url ||= "#"
  telegram_bot ||= ENV['TELEGRAM_BOT_NAME']
  telegram_auth_url ||= "#"
  classes ||= ""
%>

<% if provider.to_sym == :line %>
  <%= link_to url, class: ["btn border-0 font-medium text-sm h-[40px] min-h-[40px] rounded-xl flex items-center justify-center gap-2.5 shadow-xs hover:opacity-90 active:scale-[0.98] transition-all w-full text-white", classes].join(" "), style: "background-color: #06C755; color: #ffffff;" do %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 flex-shrink-0">
      <path d="M19.952 12.417c0-4.28-4.29-7.763-9.567-7.763-5.276 0-9.567 3.483-9.567 7.763 0 3.838 3.403 7.052 8 7.652.311.067.736.205.844.472.097.242.063.622.031.867l-.136.819c-.042.242-.193.946.828.516 1.022-.43 5.512-3.245 7.52-5.553h-.001c1.387-1.521 2.048-3.065 2.048-4.773z"/>
    </svg>
    <span>Log in with LINE</span>
  <% end %>
<% elsif provider.to_sym == :telegram %>
  <div class="<%= ["w-full flex items-center justify-center min-h-[40px] h-[40px]", classes].join(" ") %>">
    <script async src="https://telegram.org/js/telegram-widget.js?22"
            data-telegram-login="<%= telegram_bot %>"
            data-size="large"
            data-radius="10"
            data-auth-url="<%= telegram_auth_url %>"
            data-request-access="write"></script>
  </div>
<% end %>
