<%#
  DaisyUI Calendar Date & DateTime Picker Component with Fieldset & Fieldset Legend
  (https://daisyui.com/components/calendar/)
  Locals:
    - form: FormBuilder object (e.g. f) or nil
    - field_type: Symbol/String (:date, :datetime_local, :time, default: :date)
    - name: Symbol/String (attribute name, required)
    - label: String (label text) or nil / false
    - value: String / Date / Time
    - placeholder: String
    - min: String / Date / Time
    - max: String / Date / Time
    - required: Boolean
    - hint: String (help text)
    - error: String / Array (error message)
    - classes: String (wrapper extra classes)
    - input_classes: String (input element extra classes)
    - data: Hash
    - id: String
%>

<%
  form ||= nil
  field_type ||= :date
  name ||= :date
  label = nil if local_assigns[:label] == false
  label ||= name.to_s.humanize unless local_assigns[:label] == false
  placeholder ||= (field_type == :datetime_local ? "Select date & time..." : "Select date...")
  value = local_assigns[:value]
  value = form.object.send(name) if value.nil? && form.present? && form.object.respond_to?(name)
  min ||= nil
  max ||= nil
  required = !!local_assigns[:required]
  hint ||= nil
  error ||= nil
  classes ||= ""
  input_classes ||= ""
  data ||= {}
  id ||= nil

  input_id = id.presence || (form ? "#{form.object_name}_#{name}" : "field_#{name}")

  val_str = value.respond_to?(:strftime) ? value.strftime(field_type.to_sym == :datetime_local ? "%Y-%m-%dT%H:%M" : "%Y-%m-%d") : value.to_s

  field_method = case field_type.to_sym
                 when :datetime_local, :datetime then :datetime_local_field
                 when :time then :time_field
                 else :date_field
                 end
  html_type = case field_type.to_sym
              when :datetime_local, :datetime then "datetime-local"
              when :time then "time"
              else "date"
              end

  input_box_classes = [
    "input input-bordered flex items-center gap-2 w-full cursor-pointer focus-within:outline-none focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition-all",
    (error.present? ? "input-error" : ""),
    input_classes
  ].reject(&:empty?).join(" ")
%>

<fieldset class="fieldset w-full relative <%= classes %>"
          data-controller="date-picker"
          data-date-picker-mode-value="<%= field_type %>">
  <% if label.present? %>
    <legend class="fieldset-legend font-medium text-sm text-content flex items-center justify-between w-full mb-1">
      <label for="<%= input_id %>_display" class="flex items-center justify-between w-full cursor-pointer">
        <span><%= label %></span>
        <% if required %>
          <span class="text-xs text-error font-normal">*Required</span>
        <% end %>
      </label>
    </legend>
  <% end %>

  <%# Hidden actual input for form submission %>
  <% if form.present? %>
    <%= form.send(field_method, name, value: val_str, id: input_id, required: required, data: { date_picker_target: "input" }, class: "hidden") %>
  <% else %>
    <input type="<%= html_type %>" name="<%= name %>" value="<%= val_str %>" id="<%= input_id %>" <% if required %>required<% end %> data-date-picker-target="input" class="hidden" />
  <% end %>

  <%# Visible DaisyUI Input Display with Calendar Trigger %>
  <div class="<%= input_box_classes %>" data-action="click->date-picker#togglePopover">
    <span class="opacity-70 flex items-center shrink-0 text-primary">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
      </svg>
    </span>

    <input type="text"
           id="<%= input_id %>_display"
           readonly
           placeholder="<%= placeholder %>"
           data-date-picker-target="display"
           class="grow bg-transparent border-none outline-none focus:outline-none focus:ring-0 ring-0 shadow-none p-0 text-base sm:text-sm cursor-pointer select-none" />

    <span class="opacity-50 text-xs">▼</span>
  </div>

  <%# DaisyUI 5 Calendar Dropdown Popover %>
  <div data-date-picker-target="popover"
       class="hidden absolute left-0 z-50 mt-2 p-4 bg-surface border border-border/80 rounded-2xl shadow-xl w-72 backdrop-blur-md">
    
    <%# Calendar Month/Year Controls %>
    <div class="flex items-center justify-between mb-3 px-1">
      <button type="button"
              data-action="click->date-picker#prevMonth"
              class="btn btn-xs btn-ghost btn-circle text-content hover:bg-background">❮</button>
      <span data-date-picker-target="monthYear" class="text-sm font-bold text-content"></span>
      <button type="button"
              data-action="click->date-picker#nextMonth"
              class="btn btn-xs btn-ghost btn-circle text-content hover:bg-background">❯</button>
    </div>

    <%# Calendar Days Header %>
    <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold text-content-subtle mb-2">
      <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
    </div>

    <%# Calendar Grid %>
    <div data-date-picker-target="daysGrid" class="grid grid-cols-7 gap-1 text-center items-center justify-items-center">
    </div>

    <%# Optional Time Selection for DateTime Local %>
    <% if field_type.to_sym == :datetime_local %>
      <div class="pt-3 mt-3 border-t border-border/60 flex items-center justify-between gap-2">
        <span class="text-xs font-medium text-content-subtle">Time:</span>
        <div class="flex items-center gap-1">
          <select data-date-picker-target="hourSelect"
                  data-action="change->date-picker#onTimeChange"
                  class="select select-bordered select-xs text-xs bg-background">
            <% (0..23).each do |h| %>
              <option value="<%= h %>"><%= sprintf("%02d", h) %></option>
            <% end %>
          </select>
          <span class="text-xs font-bold text-content-subtle">:</span>
          <select data-date-picker-target="minuteSelect"
                  data-action="change->date-picker#onTimeChange"
                  class="select select-bordered select-xs text-xs bg-background">
            <% (0..55).step(5).each do |m| %>
              <option value="<%= m %>"><%= sprintf("%02d", m) %></option>
            <% end %>
          </select>
        </div>
      </div>
    <% end %>
  </div>

  <% if hint.present? %>
    <p class="fieldset-label text-xs text-content-muted mt-1"><%= hint %></p>
  <% end %>

  <% if error.present? %>
    <p class="fieldset-label text-xs text-error font-medium mt-1">
      <%= error.is_a?(Array) ? error.join(", ") : error %>
    </p>
  <% end %>
</fieldset>
