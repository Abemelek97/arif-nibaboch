<%#
  DaisyUI Checkbox Component
  Locals:
    - form: FormBuilder object (e.g. f) or nil
    - name: Symbol/String (attribute name, e.g. :remember_me)
    - label: String (label text)
    - checked: Boolean
    - variant: String ("primary", "secondary", "accent", etc., default: "primary")
    - size: String ("xs", "sm", "md", "lg", default: "sm")
    - classes: String (additional wrapper classes)
    - data: Hash
    - id: String
%>

<%
  form ||= nil
  name ||= :checkbox
  label ||= name.to_s.humanize
  checked ||= false
  variant ||= "primary"
  size ||= "sm"
  classes ||= ""
  data ||= {}
  id ||= nil

  checkbox_classes = [
    "checkbox",
    "checkbox-#{variant}",
    "checkbox-#{size}",
    "rounded border-border/80 transition-colors cursor-pointer",
    "focus:ring-2 focus:ring-primary focus:ring-offset-1"
  ].reject(&:empty?).join(" ")
%>

<div class="form-control inline-block <%= classes %>">
  <label class="label cursor-pointer justify-start gap-2.5 py-1 px-0 select-none group">
    <% if form.present? %>
      <%= form.check_box name, { class: checkbox_classes, checked: checked, data: data, id: id } %>
    <% else %>
      <input type="checkbox" name="<%= name %>" class="<%= checkbox_classes %>" <%= "checked" if checked %> <% data.each do |k, v| %> data-<%= k.to_s.dasherize %>="<%= v %>" <% end %> <%= "id='#{id}'" if id.present? %> />
    <% end %>
    <span class="label-text text-sm font-medium text-content group-hover:text-primary transition-colors"><%= label %></span>
  </label>
</div>
