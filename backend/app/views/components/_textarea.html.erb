<%#
  DaisyUI Textarea Component with Fieldset & Fieldset Legend
  (https://daisyui.com/components/textarea/)
  Locals:
    - form: FormBuilder object (e.g. f) or nil
    - name: Symbol/String (attribute name, required)
    - label: String (label text) or nil / false
    - placeholder: String
    - value: String
    - rows: Integer (default: 4)
    - required: Boolean
    - hint: String (help text)
    - error: String / Array (error message)
    - classes: String (wrapper extra classes)
    - textarea_classes: String (textarea element extra classes)
    - data: Hash
    - id: String
%>

<%
  form ||= nil
  name ||= :description
  label = nil if local_assigns[:label] == false
  label ||= name.to_s.humanize unless local_assigns[:label] == false
  placeholder ||= ""
  value ||= nil
  rows ||= 4
  required = !!local_assigns[:required]
  hint ||= nil
  error ||= nil
  classes ||= ""
  textarea_classes ||= ""
  data ||= {}
  id ||= nil

  input_id = id.presence || (form ? "#{form.object_name}_#{name}" : "field_#{name}")

  box_classes = [
    "textarea textarea-bordered w-full text-base sm:text-sm leading-relaxed",
    (error.present? ? "textarea-error" : ""),
    textarea_classes
  ].reject(&:empty?).join(" ")

  input_options = {
    placeholder: placeholder.presence,
    rows: rows,
    id: input_id,
    data: data.dup
  }.compact
  input_options[:value] = value if value.present?
  input_options[:required] = true if required

  raw_attrs = []
  raw_attrs << "id=\"#{ERB::Util.html_escape(input_id)}\"" if input_id.present?
  raw_attrs << "placeholder=\"#{ERB::Util.html_escape(placeholder)}\"" if placeholder.present?
  raw_attrs << "rows=\"#{rows}\""
  raw_attrs << "required" if required

  if input_options[:data].present?
    input_options[:data].each do |dk, dv|
      raw_attrs << "data-#{dk.to_s.dasherize}=\"#{ERB::Util.html_escape(dv)}\""
    end
  end
  raw_attr_str = raw_attrs.join(" ")
%>

<fieldset class="fieldset w-full <%= classes %>">
  <% if label.present? %>
    <legend class="fieldset-legend font-medium text-sm text-content flex items-center justify-between w-full">
      <label for="<%= input_id %>" class="flex items-center justify-between w-full cursor-pointer">
        <span><%= label %></span>
        <% if required %>
          <span class="text-xs text-error font-normal">*Required</span>
        <% end %>
      </label>
    </legend>
  <% end %>

  <% if form.present? %>
    <%= form.text_area name, input_options.merge(class: box_classes) %>
  <% else %>
    <textarea name="<%= name %>" <%= raw_attr_str.html_safe %> class="<%= box_classes %>"><%= value %></textarea>
  <% end %>

  <% if hint.present? %>
    <p class="fieldset-label text-xs text-content-muted"><%= hint %></p>
  <% end %>

  <% if error.present? %>
    <p class="fieldset-label text-xs text-error font-medium">
      <%= error.is_a?(Array) ? error.join(", ") : error %>
    </p>
  <% end %>
</fieldset>
