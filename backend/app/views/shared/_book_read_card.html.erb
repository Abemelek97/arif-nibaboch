<div class="card card-side bg-surface shadow-sm border border-border">
  <figure class="w-32 self-stretch flex-shrink-0 overflow-hidden">
    <img
      src="<%= book.cover_image %>"
      alt="<%= book.title %>"
      class="h-full w-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
    >
  </figure>

  <div class="card-body p-4 sm:p-5 min-w-0">
    <%# Club Name - Theme Accent Upper Label %>
    <div class="text-xs font-bold uppercase tracking-wider text-accent truncate mb-0.5">
      <%= club&.name || "Book Club" %>
    </div>

    <%# Book Title - Theme Content Header %>
    <h2 class="title title-sm font-bold text-content leading-tight line-clamp-2">
      <%= link_to book.title, book, class: "hover:text-accent transition-colors focus:outline-none" %>
    </h2>

    <%# Author - Theme Content Subtle %>
    <p class="text-xs sm:text-sm text-content-subtle mt-0.5 truncate">
      by <%= book.author.presence || "Unknown Author" %>
    </p>

    <%# Meetup Date - Theme Content Subtle %>
    <div class="mt-3 flex items-center gap-1.5 text-xs font-medium text-content-subtle min-w-0">
      <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <rect x="3" y="5" width="18" height="16" rx="3" stroke="currentColor" stroke-width="1.7"></rect>
        <path d="M3 9h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
      </svg>
      <span class="truncate">
        <%= book_read.meetup_time&.strftime("%b %d, %Y at %l:%M %p") %>
      </span>
    </div>

    <%# RSVP Button %>
    <div class="mt-4 flex items-center gap-2 w-full">
      <button
        data-disable-with="Joining..."
        class="w-full btn btn-primary btn-sm sm:btn-md disabled:opacity-50 disabled:cursor-not-allowed"
        type="submit"
      >
        RSVP
      </button>
    </div>
  </div>
</div>



