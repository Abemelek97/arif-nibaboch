<div class="card card-side bg-base-100 shadow-sm">
  <figure class="w-32 self-stretch flex-shrink-0 overflow-hidden">
    <img
      src="<%= book.cover_image %>"
      alt="<%= book.title %>"
      class="
        h-full w-full object-cover object-center group-hover:scale-105
        transition-transform duration-500
      "
    >
  </figure>

  <div class="card-body">
    <div class="card-title">
      <%= club&.name || "Book Club" %>
    </div>
    <h2 class="card-title">
      <%= link_to book.title, book, class: "focus:outline-none" %>
    </h2>
    <p>
      <%= book.author.presence || "Unknown Author" %>
    </p>
    <div
      class="
        mt-[9px] flex items-center gap-1.5 text-[12.5px] font-medium text-[#2A2520]
      "
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
        <rect
          x="3"
          y="5"
          width="18"
          height="16"
          rx="3"
          stroke="#B6603C"
          stroke-width="1.7"
        ></rect>
        <path
          d="M3 9h18M8 3v4M16 3v4"
          stroke="#B6603C"
          stroke-width="1.7"
          stroke-linecap="round"
        ></path>
      </svg>
      <span>
        <%= book_read.meetup_time&.strftime("%b %d, %Y at %l:%M %p") %>
      </span>
    </div>
    <div class="mt-4 flex items-center gap-2 w-full">
      <%# RSVP Button %>
      <button
        data-disable-with="Joining..."
        class="
          w-full btn btn-primary disabled:opacity-50 disabled:cursor-not-allowed
        "
        type="submit"
      >
        RSVP
      </button>
    </div>
  </div>
</div>
