<div class="card card-side bg-surface shadow-sm border border-border">
  <figure class="w-32 shrink-0 relative overflow-hidden">
    <div class="absolute inset-0 skeleton rounded-none"></div>
  </figure>

  <div class="card-body p-4 sm:p-5 min-w-0">
    <%# Club Header Skeleton (Circular Avatar + Name bar) %>
    <div class="flex items-center gap-2 mb-1.5">
      <div class="skeleton w-7 h-7 rounded-full shrink-0"></div>
      <div class="skeleton h-3 w-1/3"></div>
    </div>

    <%# Book Title Skeleton (prominent title bar) %>
    <div class="title title-sm font-bold">
      <div class="skeleton h-5 sm:h-6 w-3/4"></div>
    </div>

    <%# Author Skeleton %>
    <div class="mt-0.5">
      <div class="skeleton h-3.5 w-1/2"></div>
    </div>

    <%# Date & Location Skeleton %>
    <div class="mt-2.5 space-y-1">
      <div class="flex items-center gap-1.5">
        <div class="skeleton w-3.5 h-3.5 rounded-sm shrink-0"></div>
        <div class="skeleton h-3.5 w-1/2"></div>
      </div>
      <div class="flex items-center gap-1.5">
        <div class="skeleton w-3.5 h-3.5 rounded-sm shrink-0"></div>
        <div class="skeleton h-3.5 w-2/3"></div>
      </div>
    </div>

    <%# RSVP & Share Button Skeleton %>
    <div class="card-actions justify-self-end w-full mt-4 flex items-center gap-2">
      <div class="skeleton h-12 flex-1"></div>
      <div class="skeleton h-12 w-12 shrink-0"></div>
    </div>
  </div>
</div>
