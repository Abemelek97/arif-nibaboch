<div class="card card-side bg-base-100 shadow-sm">
  <figure class="w-32 self-stretch flex-shrink-0 overflow-hidden">
    <div class="w-full h-full skeleton rounded-none"></div>
  </figure>

  <div class="card-body">
    <%# Club Name Skeleton %>
    <div class="card-title">
      <div class="skeleton h-6 w-2/5"></div>
    </div>

    <%# Book Title Skeleton %>
    <div class="card-title">
      <div class="skeleton h-6 w-3/4"></div>
    </div>

    <%# Author Skeleton %>
    <p>
      <div class="skeleton h-4 w-1/3"></div>
    </p>

    <%# Date Skeleton %>
    <div class="mt-[9px] flex items-center gap-1.5">
      <div class="skeleton w-[14px] h-[14px] rounded-sm shrink-0"></div>
      <div class="skeleton h-4 w-1/2"></div>
    </div>

    <%# RSVP Button Skeleton %>
    <div class="mt-4 flex items-center gap-2 w-full">
      <div class="skeleton h-12 w-full"></div>
    </div>
  </div>
</div>
