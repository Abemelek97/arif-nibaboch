<div class="card card-side bg-surface shadow-sm border border-border">
  <figure class="w-32 self-stretch flex-shrink-0 overflow-hidden">
    <div class="w-full h-full skeleton rounded-none"></div>
  </figure>

  <div class="card-body p-4 sm:p-5">
    <%# Club Name Skeleton (small accent bar) %>
    <div class="skeleton h-3 w-1/3 mb-0.5"></div>

    <%# Book Title Skeleton (prominent title bar) %>
    <div class="title title-sm font-bold">
      <div class="skeleton h-5 sm:h-6 w-3/4"></div>
    </div>

    <%# Author Skeleton %>
    <p class="mt-0.5">
      <div class="skeleton h-3.5 w-1/2"></div>
    </p>

    <%# Date Skeleton %>
    <div class="mt-3 flex items-center gap-1.5">
      <div class="skeleton w-3.5 h-3.5 rounded-sm shrink-0"></div>
      <div class="skeleton h-3.5 w-1/2"></div>
    </div>

    <%# RSVP Button Skeleton %>
    <div class="mt-4 flex items-center gap-2 w-full">
      <div class="skeleton h-8 sm:h-12 w-full"></div>
    </div>
  </div>
</div>


